<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8"/>
        <meta http-equiv="Content-Language" content="pt-BR">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="React Layered Architecture Boilerplate - Modern, scalable frontend architecture">
        <meta name="keywords" content="react, typescript, webpack, boilerplate, layered-architecture">
        <meta name="author" content="Tiago Vilas Boas">
        <meta name="theme-color" content="#000000">
        
        <title>React Layered Architecture Boilerplate</title>
        
        <!-- Preconnect to external domains -->
        <link rel="preconnect" href="https://unpkg.com">
        
        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="<%= htmlWebpackPlugin.options.favicon %>">
    </head>
    <body>
        <noscript>You need to enable JavaScript to run this app.</noscript>
        <div id="root"></div>

        <!-- Dependencies with Official CDN Links -->
        <!-- https://react.dev/reference/react-dom/client -->
        <% if (webpackConfig.mode == 'production') { %>
        <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
        <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
        <% } else { %>
        <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
        <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
        <% } %>
    </body>
</html>
