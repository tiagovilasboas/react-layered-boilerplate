{
  "name": "react-layered-boilerplate",
  "version": "1.0.0",
  "description": "React Layered Architecture Boilerplate - Modern, scalable frontend architecture",
  "author": "Tiago Vilas Boas (Montanha) - tcarvalhovb@gmail.com",
  "license": "MIT",
  "keywords": [
    "react",
    "typescript",
    "webpack",
    "boilerplate",
    "layered-architecture",
    "styled-components"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tiagovilasboas/react-layered-boilerplate.git"
  },
  "scripts": {
    "build": "webpack --config=configs/webpack/prod.js",
    "start": "webpack serve --config=configs/webpack/dev.js",
    "dev": "webpack serve --config=configs/webpack/dev.js",
    "test": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,ts,tsx,json,css,md}'"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^3.2.4",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.30.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-vitest": "^0.5.4",
    "html-webpack-plugin": "^5.6.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "styled-components": "^6.1.19",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "webpack": "^5.99.9",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "react-router-dom": "^7.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=8.0.0"
  }
}
